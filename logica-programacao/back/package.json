{
  "name": "logica-programacao",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "cross-env NODE_ENV=dev tsx watch --require tsconfig-paths/register src/index.ts",
    "test": "node --import tsx --require tsconfig-paths/register --test test/**/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:coverage": "c8 --100 --include=src/core/features/services/*.ts --reporter=text node --import tsx --require tsconfig-paths/register --test test/**/*.test.ts"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-pattern": "^5.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "typescript": "^5.5.3"
  },
  "private": true
}
